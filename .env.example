MODEL_PROVIDER=ollama
# Maximum time for one model request before the pipeline fails instead of hanging.
MODEL_REQUEST_TIMEOUT_SECONDS=180
# Local Ollama context/output budgets. The larger context prevents planning prompts from being truncated.
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_MAX_OUTPUT_TOKENS=2048
# Keep the local model resident between the pipeline's consecutive planning calls.
OLLAMA_KEEP_ALIVE=10m
# Parallel shot-image jobs; dependency-linked shots still wait for their predecessor.
IMAGE_GENERATION_WORKERS=2
# Parallel image-to-video jobs; values are clamped to 1-4 to limit provider pressure.
VIDEO_GENERATION_WORKERS=3
HF_MODEL=Qwen/Qwen3-4B-Thinking-2507
HF_PROVIDER=nscale
HF_TOKEN=your_hugging_face_token
# Optional dedicated model for the input safety control; defaults to HF_MODEL/OLLAMA_MODEL.
# SAFETY_MODEL=your-safety-classifier-model
# Optional token prices used to estimate LLM cost in USD.
# LLM_INPUT_USD_PER_1M_TOKENS=0.00
# LLM_OUTPUT_USD_PER_1M_TOKENS=0.00
DIRECTOR_MODEL=Qwen/Qwen3-4B-Thinking-2507
# Optional; defaults to HF_MODEL/OLLAMA_MODEL.
# IMAGE_PROMPT_BUILDER_MODEL=Qwen/Qwen3-4B-Thinking-2507
# Optional provider-wide QA model.
QA_MODEL=your-vision-model
# Required for the Ollama Combined Video Judge; use a locally installed vision-capable model.
OLLAMA_QA_MODEL=qwen2.5vl:3b
# Optional dedicated vision model for still-image review; defaults to OLLAMA_QA_MODEL on Ollama and QA_MODEL elsewhere.
# SHOT_IMAGE_QA_MODEL=your-vision-model
# Optional dedicated text model for per-shot motion planning.
# MOTION_PLANNER_MODEL=your-model

# Only required when another dormant Gemini integration is used.
GEMINI_API_KEY=your_gemini_api_key
# Optional model for other Gemini text/vision calls; the combined judge uses QA_MODEL.
GEMINI_MODEL=gemini-3.6-flash
# Groq alternative: set MODEL_PROVIDER=groq and provide GROQ_API_KEY.
GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=llama-3.3-70b-versatile
# Recommended per-agent Groq routing:
# GROQ_STORY_MODEL=openai/gpt-oss-120b
# GROQ_DIRECTOR_MODEL=openai/gpt-oss-120b
# GROQ_NARRATION_MODEL=openai/gpt-oss-20b
# GROQ_SCENE_MODEL=openai/gpt-oss-20b
# GROQ_SHOT_PLANNER_MODEL=openai/gpt-oss-20b
# Alternative structured-output model: qwen/qwen3.8-27b
# Safety currently uses a chat-capable model because the safety node expects JSON.
# Prompt Guard requires a separate classifier adapter, not chat completions.
# GROQ_SAFETY_MODEL=openai/gpt-oss-20b
# Reserved for a future tool-using agent: GROQ_TOOL_MODEL=groq/compound
MAGNIFIC_API_KEY=your_magnific_api_key
# Calls Magnific Improve Prompt before image/video generation.
MAGNIFIC_IMPROVE_PROMPTS=true
MUSIC_ENABLED=false
# Optional override; the bundled image fixes the five-view character-sheet layout.
CHARACTER_SHEET_REFERENCE_IMAGE=assets/character_sheet_layout_reference.png
ELEVENLABS_API_KEY=your_elevenlabs_api_key
# Use eleven_turbo_v2_5 here when higher quality matters more than Flash latency.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional MinIO artifact storage. Local artifact history is always kept.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=softframe-artifacts
MINIO_SECURE=false
# WAN 2.7 is enabled only when this points to internet-reachable MinIO.
# MINIO_PUBLIC_ENDPOINT=https://media.example.com
